+  const REQ_IMG = { huella: null };
+  function reqPrecargarImagenes() {
+    try {
+      if (!REQ_IMG.huella) {
+        REQ_IMG.huella = new Image();
+        REQ_IMG.huella.decoding = 'async';
+        REQ_IMG.huella.src = 'huella-tinta.png?v=2';
