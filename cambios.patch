+  s = s.replace(/[^a-zñ\s]/g, ' ');
+  /* Letras repetidas: "estafaaaaador" -> "estafaador", "perrro" -> "perro". */
+  s = s.replace(/([a-zñ])\1{2,}/g, '$1$1');
