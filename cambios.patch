+     ================================================================== */
+  const REQ = {
+    habilitado: false,
+    servicio: '',
+    paso: 1,
+    foto: '',
+    firma: '',
+    huella: '',
+    stream: null,
+    firmaDibujada: false,
+    firmaTrazo: false,
+    huellaTimer: null,
+    huellaProg: 0,
+  };
+
+  const REQ_SERVICIOS = {
+    cedula: 'C\u00e9dula de identidad',
+    licencia: 'Licencia de conducir',
+    antecedentes: 'Antecedentes penales',
+    pasaporte: 'Pasaporte',
+  };
