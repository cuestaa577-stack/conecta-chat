+      return;
+    }
+    track.innerHTML = REFS.items.map(refCardHtml).join('');
+    REFS.idx = 0;
+    refIr(0, false);
+    refArrancarAuto();
+  }
+
+  function refPintarResumen(d) {
+    const score = $('#refsScore');
+    if (!score) return;
+    const total = Number(d.total || 0);
+    if (!total) { score.hidden = true; return; }
