+    } catch (e) {
+      toast(e.message, 'bad');
+    } finally {
+      if (btn) {
+        btn.disabled = false;
+        btn.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5l16-7-7 16-2.2-6.8z"/></svg>Publicar mi opini\u00f3n';
+      }
+    }
+  }
+
+  /* Arrastre con el dedo y freno del carrusel mientras se escribe. */
+  function refBind() {
